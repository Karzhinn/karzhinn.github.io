---
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <div class="orb orb-a" data-parallax="0.25"></div>
    <div class="orb orb-b" data-parallax="0.4"></div>
    <div class="orb orb-c" data-parallax="0.15"></div>
    <div class="lens lens-a" data-lens="1"></div>
    <div class="lens lens-b" data-lens="-0.6"></div>
  </div>

  <div class="hero-inner container" data-hero-inner>
    <p class="hero-status glass" data-hero-item>
      <span class="status-dot" aria-hidden="true"></span>
      <span>{site.currentRole.title} at {site.currentRole.org}</span>
    </p>

    <h1 class="hero-title" id="hero-title">
      <span class="line-mask"><span class="metal-text" data-hero-line>Karzhin</span></span>
      <span class="line-mask"><span class="metal-text" data-hero-line>Kamal</span></span>
    </h1>

    <p class="hero-headline" data-hero-item>{site.headline}</p>
    <p class="hero-statement lead" data-hero-item>{site.statement}</p>

    <div class="hero-actions" data-hero-item>
      <a class="btn btn-solid" href="#projects" data-magnetic>
        See my work
        <svg class="btn-icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M4 10h11m0 0-4.5-4.5M15 10l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a class="btn btn-glass glass" href="#contact" data-magnetic>Get in touch</a>
    </div>
  </div>

  <a class="scroll-cue" href="#about" data-hero-item>
    <span>Scroll</span>
    <span class="scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding-block: calc(var(--nav-h) + 4rem) 7rem;
    overflow: clip;
  }

  /* ---------- ambient background ---------- */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .orb-a {
    top: -18%;
    left: -12%;
    width: 62vmax;
    height: 62vmax;
    background: radial-gradient(circle at 50% 50%, var(--orb-a), transparent 64%);
    animation: drift-a 26s var(--ease-in-out) infinite alternate;
  }

  .orb-b {
    top: 18%;
    right: -18%;
    width: 56vmax;
    height: 56vmax;
    background: radial-gradient(circle at 50% 50%, var(--orb-b), transparent 64%);
    animation: drift-b 32s var(--ease-in-out) infinite alternate;
  }

  .orb-c {
    bottom: -30%;
    left: 22%;
    width: 50vmax;
    height: 50vmax;
    background: radial-gradient(circle at 50% 50%, var(--orb-c), transparent 64%);
    animation: drift-c 28s var(--ease-in-out) infinite alternate;
  }

  .hero {
    --orb-a: rgb(206 214 232 / 0.75);
    --orb-b: rgb(232 224 240 / 0.7);
    --orb-c: rgb(214 228 234 / 0.7);
  }

  :global([data-theme='dark']) .hero {
    --orb-a: rgb(70 78 100 / 0.42);
    --orb-b: rgb(78 66 96 / 0.34);
    --orb-c: rgb(56 74 84 / 0.36);
  }

  /* Drift uses the individual `translate`/`scale` properties so it composes
     with the scroll parallax GSAP applies through `transform`. */
  @keyframes drift-a {
    to {
      translate: 8vw 6vh;
      scale: 1.08;
    }
  }

  @keyframes drift-b {
    to {
      translate: -10vw -4vh;
      scale: 0.94;
    }
  }

  @keyframes drift-c {
    to {
      translate: 6vw -8vh;
      scale: 1.1;
    }
  }

  :global(.motion) [data-hero-item] {
    opacity: 0;
  }

  /* Floating glass lenses that refract (blur) the orbs behind them. */
  .lens {
    position: absolute;
    border-radius: 50%;
    background:
      radial-gradient(120% 120% at 28% 22%, rgb(255 255 255 / 0.55), transparent 42%),
      linear-gradient(160deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0.04));
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
    border: 1px solid rgb(255 255 255 / 0.55);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.9),
      inset 0 -10px 30px rgb(255 255 255 / 0.18),
      inset 0 10px 24px rgb(0 0 0 / 0.04),
      0 30px 60px -30px rgb(20 20 40 / 0.35);
  }

  :global([data-theme='dark']) .lens {
    background:
      radial-gradient(90% 90% at 30% 24%, rgb(255 255 255 / 0.2), transparent 45%),
      radial-gradient(70% 70% at 75% 85%, rgb(170 185 230 / 0.12), transparent 60%),
      linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.02));
    border-color: rgb(255 255 255 / 0.18);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.35),
      inset 0 -1px 1px rgb(255 255 255 / 0.08),
      inset -14px -18px 36px rgb(160 175 220 / 0.08),
      0 30px 60px -30px rgb(0 0 0 / 0.8);
  }

  .lens-a {
    top: 8%;
    right: 6.5%;
    width: clamp(120px, 14vw, 215px);
    aspect-ratio: 1;
    animation: float 11s var(--ease-in-out) infinite alternate;
  }

  .lens-b {
    bottom: 16%;
    left: 7%;
    width: clamp(70px, 8vw, 128px);
    aspect-ratio: 1;
    animation: float 9s var(--ease-in-out) -3s infinite alternate;
  }

  @keyframes float {
    from {
      translate: 0 -10px;
    }
    to {
      translate: 0 12px;
    }
  }

  /* ---------- content ---------- */
  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transform-origin: 50% 40%;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1rem 0.5rem 0.85rem;
    border-radius: var(--r-pill);
    font-size: var(--fs-micro);
    font-weight: 550;
    letter-spacing: -0.005em;
    color: var(--text-2);
    --glass-blur: 16px;
  }

  .status-dot {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--live);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--live) 18%, transparent);
  }

  .status-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--live);
    animation: pulse 2.6s var(--ease-out) infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    70%,
    100% {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .hero-title {
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
    font-size: clamp(3.6rem, 0.8rem + 11.2vw, 12rem);
    font-weight: 640;
    line-height: 0.9;
    letter-spacing: -0.055em;
  }

  .hero-title .line-mask {
    display: inline-block;
    padding-inline: 0.04em;
  }

  .hero-headline {
    margin-top: clamp(1.5rem, 2.6vw, 2.25rem);
    font-size: clamp(1.15rem, 0.95rem + 0.9vw, 1.75rem);
    font-weight: 560;
    letter-spacing: -0.022em;
    line-height: 1.25;
    color: var(--text);
    text-wrap: balance;
  }

  .hero-statement {
    max-width: 34ch;
    margin-top: 0.9rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: clamp(2rem, 3.4vw, 2.75rem);
  }

  /* ---------- scroll cue ---------- */
  .scroll-cue {
    position: absolute;
    bottom: max(1.75rem, env(safe-area-inset-bottom));
    left: 0;
    right: 0;
    width: fit-content;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.75rem;
    font-weight: 550;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .scroll-line {
    position: relative;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: var(--line-2);
  }

  .scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, var(--text));
    animation: cue 2.4s var(--ease-in-out) infinite;
  }

  @keyframes cue {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(100%);
    }
  }

  @media (max-width: 640px) {
    .hero-title .line-mask {
      display: block;
    }

    .lens-a {
      top: 24%;
      right: -18%;
    }

    .lens-b {
      display: none;
    }

    .hero-actions .btn {
      flex: 1 1 100%;
      max-width: 320px;
    }
  }

  @media (max-height: 640px) and (min-width: 641px) {
    .scroll-cue {
      display: none;
    }
  }
</style>
