---
import { about } from '../data/site';
---

<section class="about" id="about" aria-labelledby="about-title" data-about>
  <div class="container about-grid">
    <header class="about-intro">
      <p class="eyebrow" data-reveal="up"><span class="eyebrow-index">01</span>About</p>
      <h2 class="h2 about-title" id="about-title" data-reveal="blur">{about.title}</h2>
      <p class="lead about-lead" data-reveal="up">{about.lead}</p>
    </header>

    <div class="about-visual" aria-hidden="true">
      <div class="scene" data-about-scene>
        <canvas class="scene-canvas" data-about-canvas></canvas>
      </div>
      <ol class="scene-legend" role="list">
        {
          about.chapters.map((chapter, i) => (
            <li class="legend-item" data-legend={i}>
              <span>0{i + 1}</span>
              {chapter.key}
            </li>
          ))
        }
      </ol>
    </div>

    <ol class="chapters" role="list">
      {
        about.chapters.map((chapter, i) => (
          <li class="chapter" data-chapter={i}>
            <div class="chapter-card">
              <p class="chapter-key">
                <span class="chapter-num">0{i + 1}</span>
                {chapter.key}
              </p>
              <h3 class="h3 chapter-title">{chapter.title}</h3>
              <p class="chapter-body">{chapter.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .about {
    --pool: rgb(212 218 233 / 0.75);
    position: relative;
    padding-top: calc(var(--section-y) * 0.6);
  }

  :global([data-theme='dark']) .about {
    --pool: rgb(92 100 126 / 0.26);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    grid-template-areas:
      'visual intro'
      'visual chapters';
    column-gap: clamp(2.5rem, 6vw, 6.5rem);
  }

  /* ---------- intro ---------- */
  .about-intro {
    grid-area: intro;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 1.25rem;
    min-height: 80svh;
    padding-block: 8svh 4svh;
  }

  .about-title {
    font-size: clamp(2.15rem, 1.2rem + 2.7vw, 4rem);
  }

  .about-lead {
    max-width: 36ch;
  }

  /* ---------- sticky 3D stage ---------- */
  .about-visual {
    grid-area: visual;
    position: sticky;
    top: 0;
    align-self: start;
    display: grid;
    place-items: center;
    height: 100svh;
  }

  .scene {
    position: relative;
    width: min(100%, 80svh, 720px);
    aspect-ratio: 1;
  }

  /* A soft pool of light behind the object. */
  .scene::before {
    content: '';
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--pool), transparent);
  }

  /* The radial mask lets blocks and the floor shadow fade out softly instead
     of being cut by the canvas edge. */
  .scene-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    -webkit-mask-image: radial-gradient(closest-side, #000 74%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 74%, transparent 100%);
    transition: opacity 1400ms var(--ease-out);
  }

  .scene.is-ready .scene-canvas {
    opacity: 1;
  }

  .scene-legend {
    position: absolute;
    bottom: 7svh;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 1.75rem;
    font-size: var(--fs-micro);
    font-weight: 560;
    color: var(--text-3);
  }

  .legend-item {
    display: flex;
    gap: 0.5rem;
    transition: color 500ms var(--ease-out);
  }

  .legend-item span {
    font-variant-numeric: tabular-nums;
  }

  .legend-item.is-active {
    color: var(--text);
  }

  /* ---------- chapters ---------- */
  .chapters {
    grid-area: chapters;
  }

  .chapter {
    display: flex;
    align-items: center;
    min-height: 74svh;
  }

  .chapter:last-child {
    min-height: 64svh;
  }

  .chapter-card {
    max-width: 30rem;
    transition:
      opacity 700ms var(--ease-out),
      translate 700ms var(--ease-out);
  }

  :global(.motion) .chapter:not(.is-active) .chapter-card {
    opacity: 0.25;
    translate: 0 12px;
  }

  .chapter-key {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-micro);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .chapter-num {
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
  }

  .chapter-title {
    margin-top: 0.9rem;
  }

  .chapter-body {
    max-width: 40ch;
    margin-top: 1rem;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* ---------- without JS or WebGL: one text column ---------- */
  :global(html:not(.js)) .about-visual,
  .about.no-webgl .about-visual {
    display: none;
  }

  :global(html:not(.js)) .about-grid,
  .about.no-webgl .about-grid {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'intro'
      'chapters';
  }

  :global(html:not(.js)) .chapter,
  .about.no-webgl .chapter {
    min-height: 0;
    padding-block: 1.5rem;
  }

  /* ---------- phones & small tablets ---------- */
  @media (max-width: 880px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'intro'
        'visual'
        'chapters';
    }

    .about-intro {
      min-height: 0;
      padding-block: 0 1.5rem;
    }

    .about-visual {
      top: calc(var(--nav-h) + 1.25rem);
      z-index: 0;
      height: auto;
    }

    .scene {
      width: min(100%, 50svh, 460px);
    }

    .scene-legend {
      display: none;
    }

    /* Glass cards glide over the sticky object. */
    .chapters {
      position: relative;
      z-index: 1;
    }

    .chapter,
    .chapter:last-child {
      align-items: flex-end;
      min-height: 62svh;
      padding-bottom: 5svh;
    }

    .chapter-card {
      max-width: none;
      padding: 1.35rem 1.4rem 1.5rem;
      border-radius: var(--r-lg);
      background: linear-gradient(180deg, var(--glass-tint-top), var(--glass-tint-bottom));
      -webkit-backdrop-filter: blur(20px) saturate(170%);
      backdrop-filter: blur(20px) saturate(170%);
      border: 1px solid var(--glass-border);
      box-shadow:
        inset 0 1px 0 var(--glass-inset-hi),
        var(--glass-shadow);
    }

    .chapter-body {
      font-size: 1.0625rem;
    }

    :global(.motion) .chapter:not(.is-active) .chapter-card {
      opacity: 0.6;
    }
  }
</style>
